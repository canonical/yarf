{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pre-commit": {
    "enabled": true
  },
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "commitMessagePrefix": "[Infra] ",
  "packageRules": [
    {
      "matchPackageNames": [
        "mypy",
        "pre-commit/mirrors-mypy"
      ],
      "groupName": "mypy",
      "groupSlug": "mypy"
    },
    {
      "description": "Automerge the dev dependency group",
      "matchManagers": [
        "pep621"
      ],
      "matchDepTypes": [
        "dependency-groups"
      ],
      "matchJsonata": [
        "managerData.depGroup = 'dev'"
      ],
      "automerge": true
    }
  ]
}
