{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "pre-commit": {
    "enabled": true
  },
  "labels": [
    "dependencies"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "commitMessagePrefix": "[Infra] ",
  "packageRules": [
    {
      "matchPackageNames": [
        "mypy",
        "pre-commit/mirrors-mypy"
      ],
      "groupName": "mypy",
      "groupSlug": "mypy"
    }
  ]
}
